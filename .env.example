# VINASTRA AEROSPACE — ENVIRONMENT CONFIGURATION
# Copy to .env for local overrides (never commit .env to version control)

# Server Configuration
PORT=4174
NODE_ENV=development
APP_URL=http://localhost:4174

# Session & Security
# Generate a 64+ char random hex string in production: openssl rand -hex 32
JWT_SECRET=vinastra_ascs_telemetry_secure_jwt_secret_key_2026_deeptech_orbit
SESSION_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# Database Configuration (Optional external database connection string)
# When omitted, Vinastra uses the built-in resilient file/in-memory transactional data engine
# DATABASE_URL=postgresql://user:password@localhost:5432/vinastra_db
# FIRESTORE_PROJECT_ID=vinastra-aerospace-clientside

# Storage Configuration
# Local storage path or cloud bucket name
STORAGE_DRIVER=local
STORAGE_PATH=./data/secure_vault
# S3_BUCKET_NAME=vinastra-secure-vault
# AWS_REGION=ap-south-1

# Communications & Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thesparkofwisdom@gmail.com
SMTP_PASS=
SUPPORT_EMAIL=thesparkofwisdom@gmail.com

# Initial SuperAdmin Credentials (Bootstrap on first boot)
ADMIN_BOOTSTRAP_EMAIL=admin@vinastra.space
ADMIN_BOOTSTRAP_PASS=VinastraAdmin2026!
