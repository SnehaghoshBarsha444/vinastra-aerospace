# VINASTRA AEROSPACE — ENVIRONMENT TEMPLATE
# 
# Copy this file to .env and fill in your values
# The .env file is gitignored and will NOT be committed to version control
#
# For Vercel deployment, add these variables in:
# Vercel Dashboard > Your Project > Settings > Environment Variables

# ============================================================
# SERVER CONFIGURATION
# ============================================================

PORT=4174
NODE_ENV=development
APP_URL=http://localhost:4174

# ============================================================
# SESSION & SECURITY
# ============================================================

# Generate a secure random string: openssl rand -hex 32
JWT_SECRET=your-secure-random-string-here-change-this
SESSION_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# ============================================================
# FIREBASE CLIENT (Browser-Side)
# Project: vinastra-aerospace-clientside
# ============================================================

# These values are SAFE to use in browser code
# Copy the values from your actual .env file

FIREBASE_CLIENT_PROJECT_ID=vinastra-aerospace-clientside
FIREBASE_CLIENT_API_KEY=AIzaSyDbaUl5GYen5EpQj1wg9o9pRRA56Fn_Nuo
FIREBASE_CLIENT_AUTH_DOMAIN=vinastra-aerospace-clientside.firebaseapp.com
FIREBASE_CLIENT_STORAGE_BUCKET=vinastra-aerospace-clientside.firebasestorage.app

# ============================================================
# FIREBASE CLIENT ADMIN SDK (Server-Side)
# Project: vinastra-aerospace-clientside
# ============================================================

